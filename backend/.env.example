# ==============================================================================
# MyCoinwise Backend Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (Required)
# e.g., mongodb://localhost:27017/mycoinwise or MongoDB Atlas URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mycoinwise?retryWrites=true&w=majority

# Security & Authentication (Required)
# Generate a secure 256-bit key using: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_replace_in_production

# AI Engine / Google Gemini API (Required for AI insights & chat)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Sentry Application Monitoring & Error Tracking (Optional)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Distributed Cache & Rate Limiting (Optional - for multi-instance deployments)
REDIS_URL=redis://localhost:6379

# Allowed CORS Origins (Optional comma-separated or set individually)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Tax Center (disabled by default in production until reviewed)
FEATURE_TAX_MODULE=false
# Required to encrypt tax document references at rest (generate with openssl rand -base64 32)
TAX_FIELD_ENCRYPTION_KEY=replace_with_a_32_byte_secret
# Required for the protected idempotent rule seed endpoint
TAX_ADMIN_TOKEN=replace_with_a_long_admin_token
